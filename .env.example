# Copy to .env (git-ignored) and replace every CHANGEME with a real value.
# Docker Compose reads .env automatically; compose.yaml refuses to start
# without these set.
MYSQL_ROOT_PASSWORD=CHANGEME
MYSQL_DATABASE=CHANGEME
MYSQL_USER=CHANGEME
MYSQL_PASSWORD=CHANGEME
# Host port for the container. 3307 avoids clashing with a local MySQL on 3306.
MYSQL_PORT=3307
