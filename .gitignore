target/
.idea/
*.iml
.vscode/

.env
# Credentials for running the prod profile from a laptop; templates stay tracked
/config/*
!/config/*.example

# Terraform: state contains credentials in plain text, tfvars holds them too
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/.terraform.lock.hcl
terraform/terraform.tfvars
terraform/*.tfplan
terraform/tfplan*
# The database CA certificate; not secret, but downloaded per environment
terraform/*.pem

# Frontend
frontend/node_modules/
frontend/dist/

# Playwright MCP snapshots, logs and UI review screenshots
.playwright-mcp/
