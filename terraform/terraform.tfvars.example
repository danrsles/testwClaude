# Copy to terraform.tfvars (git-ignored) and fill in real values.
ssh_cidr = "CHANGEME/32" # your public IP
app_cidr = "CHANGEME/32" # your public IP, or 0.0.0.0/0 for a public API
key_name = "CHANGEME"    # an existing EC2 key pair name

# Hosted database (Aiven). sslrootcert must stay /certs/ca.pem: that is where
# the certificate is mounted inside the container, not a path on your machine.
db_url      = "jdbc:postgresql://CHANGEME.aivencloud.com:CHANGEME/defaultdb?sslmode=verify-full&sslrootcert=/certs/ca.pem"
db_user     = "avnadmin"

# The password does NOT go in this file. Set it in your shell for the apply:
#   bash:        export TF_VAR_db_password='...'
#   PowerShell:  $env:TF_VAR_db_password = '...'
# Terraform writes it to SSM Parameter Store and keeps no copy in its state.
# After changing the password, bump this so Terraform sends the new value:
# db_password_version = 1

# Aiven's CA certificate: download ca.pem from the Aiven console into this
# directory (git-ignored), or point this at wherever you saved it.
# db_ca_cert_path = "ca.pem"


