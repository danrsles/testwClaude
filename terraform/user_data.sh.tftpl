#!/bin/bash
set -euo pipefail
# No `set -x`: it would echo the secrets into the cloud-init log.

# Docker Engine plus the compose plugin (compose is not in the AL2023 repos).
dnf update -y
dnf install -y docker
systemctl enable --now docker
usermod -aG docker ec2-user

mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

mkdir -p /opt/wants
cd /opt/wants

# The database's CA certificate. Not secret, so it travels in user data.
# Mounted read-only into the container at /certs/ca.pem, the path db_url's
# sslrootcert names.
cat > ca.pem <<'CERTEOF'
${db_ca_cert}
CERTEOF
chmod 644 ca.pem

# Secrets are never in user data: the instance role may read these two SSM
# parameters, and nothing else.
ssm_get() {
  aws ssm get-parameter --region '${region}' --name "$1" \
    --with-decryption --query Parameter.Value --output text
}
DB_PASSWORD="$(ssm_get '${db_password_parameter}')"
ORIGIN_SECRET="$(ssm_get '${origin_secret_parameter}')"

# Single quotes keep Compose from interpreting characters in the values, such as
# the & in the URL.
umask 077
{
  printf "DB_URL='%s'\n" '${db_url}'
  printf "DB_USER='%s'\n" '${db_user}'
  printf "DB_PASSWORD='%s'\n" "$DB_PASSWORD"
  printf "ORIGIN_SECRET='%s'\n" "$ORIGIN_SECRET"
} > .env
umask 022
unset DB_PASSWORD ORIGIN_SECRET

cat > compose.yaml <<'COMPOSEEOF'
services:
  app:
    image: ${image}
    restart: unless-stopped
    # The image runs the prod profile, which reads DB_URL, DB_USER and
    # DB_PASSWORD from the environment, and rejects requests whose
    # X-Origin-Secret header does not match ORIGIN_SECRET.
    env_file: .env
    volumes:
      - ./ca.pem:/certs/ca.pem:ro
    ports:
      - "${app_port}:8080"
COMPOSEEOF

docker compose up -d
