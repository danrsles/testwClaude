#!/bin/bash
set -euo pipefail
# No `set -x`: it would echo the database password into the cloud-init log.

# Docker Engine plus the compose plugin (compose is not in the AL2023 repos).
dnf update -y
dnf install -y docker
systemctl enable --now docker
usermod -aG docker ec2-user

mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

mkdir -p /opt/wants
cd /opt/wants

# The database's CA certificate. Not secret, so it travels in user data.
# Mounted read-only into the container at /certs/ca.pem, the path db_url's
# sslrootcert names.
cat > ca.pem <<'CERTEOF'
${db_ca_cert}
CERTEOF
chmod 644 ca.pem

# The password is never in user data: the instance role may read this one SSM
# parameter, and nothing else.
DB_PASSWORD="$(aws ssm get-parameter \
  --region '${region}' \
  --name '${db_password_parameter}' \
  --with-decryption \
  --query Parameter.Value \
  --output text)"

# Single quotes keep Compose from interpreting characters in the values, such as
# the & in the URL.
umask 077
{
  printf "DB_URL='%s'\n" '${db_url}'
  printf "DB_USER='%s'\n" '${db_user}'
  printf "DB_PASSWORD='%s'\n" "$DB_PASSWORD"
} > .env
umask 022
unset DB_PASSWORD

cat > compose.yaml <<'COMPOSEEOF'
services:
  app:
    image: ${image}
    restart: unless-stopped
    # The image runs the prod profile, which reads DB_URL, DB_USER and
    # DB_PASSWORD from the environment.
    env_file: .env
    volumes:
      - ./ca.pem:/certs/ca.pem:ro
    ports:
      - "${app_port}:8080"
COMPOSEEOF

docker compose up -d
