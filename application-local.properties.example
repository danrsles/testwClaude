# Copy to application-local.properties (git-ignored) and replace every CHANGEME.
# Spring loads this file at startup via spring.config.import; values here
# override src/main/resources/application.properties.
#
# These must match the credentials in .env, since that is what the MySQL
# container is created with.

spring.datasource.url=jdbc:mysql://localhost:3307/CHANGEME
spring.datasource.username=CHANGEME
spring.datasource.password=CHANGEME
