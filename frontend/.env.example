# Copy to .env.local (git-ignored by *.local) for `npm run dev`.
#
# Clerk dashboard > Configure > API keys > "Publishable key". It is public by
# design: it is compiled into the JavaScript every visitor downloads, and only
# tells Clerk's widgets which instance to talk to. Never put the secret key
# (sk_...) here or anywhere in frontend/; nothing in this app needs it.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_CHANGEME
